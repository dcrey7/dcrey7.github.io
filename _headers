# Security headers for Cloudflare Pages.
# One block for every route. CSP lists exactly the outside services the
# site really uses: YouTube (radio + demo videos), Google Fonts, Google
# Translate, Supabase (reviews), cdnjs (three.js for the space theme),
# and the Cloudflare analytics beacon.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.youtube.com https://s.ytimg.com https://translate.google.com https://translate.googleapis.com https://translate-pa.googleapis.com https://www.gstatic.com https://cdnjs.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://www.gstatic.com https://translate.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://i.ytimg.com https://*.supabase.co https://www.gstatic.com https://translate.googleapis.com https://fonts.gstatic.com https://www.google.com; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; connect-src 'self' blob: https://*.supabase.co https://translate.googleapis.com https://translate-pa.googleapis.com https://translate.google.com https://cloudflareinsights.com; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# The theme pages are self-contained WebGL demos with INLINE scripts.
# They need their own, looser policy, or the strict one above blanks
# them. They load nothing external except three.js for space.html.
/themes/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'
